<?xml version="1.0" encoding="UTF-16"?>
<!--
  HSM Sync — Windows Task Scheduler definition
  Runs hsm-sync every 15 minutes, catching up missed runs after downtime.

  Deployment model: build hsm-sync.exe once on a Windows machine (see scripts\build-exe.ps1),
  copy the resulting dist\hsm-sync.exe to Server A alongside .env. No Python or uv required
  on the server — the executable is fully self-contained.

  Import with:
    schtasks /Create /XML taskscheduler\hsm-sync.xml /TN "HSM Sync" /RU "DOMAIN\deploy" /RP
  Or via Task Scheduler GUI: Action > Import Task...

  Before importing:
    1. Edit <Command> to the full path of hsm-sync.exe on Server A
    2. Edit <WorkingDirectory> to the folder containing hsm-sync.exe and .env (same folder)
    3. Edit <UserId> to the Windows account that owns the SSH key
-->
<Task version="1.4" xmlns="http://schemas.microsoft.com/windows/2004/02/mit/task">

  <RegistrationInfo>
    <Description>HSM Sync — commit httdocs changes to git and rsync A to B every 15 minutes</Description>
    <Author>operator</Author>
  </RegistrationInfo>

  <Triggers>
    <TimeTrigger>
      <!--
        Fires at midnight, then repeats every 15 minutes indefinitely.
        Adjust PT15M to change the sync interval (PT5M = 5 min, PT30M = 30 min).
      -->
      <Repetition>
        <Interval>PT15M</Interval>
        <StopAtDurationEnd>false</StopAtDurationEnd>
      </Repetition>
      <StartBoundary>2026-01-01T00:00:00</StartBoundary>
      <Enabled>true</Enabled>
    </TimeTrigger>
  </Triggers>

  <Principals>
    <Principal id="Author">
      <!-- Edit to the Windows account that owns the SSH key and httdocs path -->
      <UserId>deploy</UserId>
      <!-- Password logon required so the task runs when the user is not logged in -->
      <LogonType>Password</LogonType>
      <RunLevel>LeastPrivilege</RunLevel>
    </Principal>
  </Principals>

  <Settings>
    <!-- Skip new trigger if a previous run is still going (no overlapping executions) -->
    <MultipleInstancesPolicy>IgnoreNew</MultipleInstancesPolicy>
    <DisallowStartIfOnBatteries>false</DisallowStartIfOnBatteries>
    <StopIfGoingOnBatteries>false</StopIfGoingOnBatteries>
    <AllowHardTerminate>true</AllowHardTerminate>
    <!-- Run as soon as possible after a missed trigger (equivalent to systemd Persistent=true) -->
    <StartWhenAvailable>true</StartWhenAvailable>
    <RunOnlyIfNetworkAvailable>true</RunOnlyIfNetworkAvailable>
    <IdleSettings>
      <StopOnIdleEnd>false</StopOnIdleEnd>
      <RestartOnIdle>false</RestartOnIdle>
    </IdleSettings>
    <AllowStartOnDemand>true</AllowStartOnDemand>
    <Enabled>true</Enabled>
    <Hidden>false</Hidden>
    <RunOnlyIfIdle>false</RunOnlyIfIdle>
    <WakeToRun>false</WakeToRun>
    <!-- Kill the task if it runs longer than 1 hour (tune to expected sync duration) -->
    <ExecutionTimeLimit>PT1H</ExecutionTimeLimit>
    <Priority>7</Priority>
  </Settings>

  <Actions Context="Author">
    <Exec>
      <!--
        <Command>: full path to hsm-sync.exe on Server A
        <WorkingDirectory>: the folder that contains BOTH hsm-sync.exe AND .env
        No <Arguments> needed — the executable is self-contained.
      -->
      <Command>C:\hsm-sync\hsm-sync.exe</Command>
      <WorkingDirectory>C:\hsm-sync</WorkingDirectory>
    </Exec>
  </Actions>

</Task>
