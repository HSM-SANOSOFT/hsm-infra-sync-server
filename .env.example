# =============================================================================
# HSM Sync — environment configuration (Server A, Windows)
# Copy this file to .env in the SAME folder as hsm-sync.exe and fill in all
# values before first run. The executable reads .env from its working directory.
#
# No extra software required on Server A — hsm-sync.exe is fully self-contained.
# Server B needs OpenSSH Server enabled (Windows optional feature).
# Use forward slashes for all paths (C:/path/to/dir).
# =============================================================================

# -----------------------------------------------------------------------------
# Server A — source (this machine)
# Path to the folder whose contents are tracked in git and synced to Server B.
# -----------------------------------------------------------------------------
HOST_FOLDER_TO_SYNC_PATH=C:/Users/deploy/httdocs

# -----------------------------------------------------------------------------
# Server B — replica target
# REMOTE_FOLDER_TO_SYNC_PATH is the SFTP-accessible path on Server B.
# With Windows OpenSSH Server use forward slashes: C:/path or /C:/path —
# verify using an SFTP client (e.g. WinSCP) before first run.
# -----------------------------------------------------------------------------
REMOTE_HOST=192.168.1.100
REMOTE_USER=deploy
REMOTE_FOLDER_TO_SYNC_PATH=C:/Users/deploy/httdocs

# -----------------------------------------------------------------------------
# SSH authentication (A → B)
#
# SSH_PRIVATE_KEY_PATH: path to the PRIVATE key file on Server A.
#   The tool uses the private key to prove its identity when connecting to B.
#   The matching PUBLIC key must be in Server B's authorized_keys:
#     C:/Users/deploy/.ssh/authorized_keys  (on Server B)
#
# Generate a key pair if you don't have one (run on Server A):
#   ssh-keygen -t ed25519 -f C:/Users/deploy/.ssh/hsm_sync -N ""
#   This produces:  hsm_sync       (private key — set SSH_PRIVATE_KEY_PATH to this)
#                   hsm_sync.pub   (public key  — append to Server B authorized_keys)
# -----------------------------------------------------------------------------
SSH_PRIVATE_KEY_PATH=C:/Users/deploy/.ssh/hsm_sync

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------

# A-side JSON-lines log — created automatically on Server A
HOST_LOG_PATH=C:/hsm-sync/logs/sync.log

# B-side append log — written via SSH + cmd.exe on Server B
REMOTE_LOG_PATH=C:/Users/deploy/hsm-sync.log

# How many days to keep A-side log entries (default: 7)
LOG_RETENTION_DAYS=7

# -----------------------------------------------------------------------------
# State file — tracks last synced commit hash; absence triggers a full sync
# Default: .hsm-sync-state in the same folder as HOST_LOG_PATH
# Uncomment to override.
# -----------------------------------------------------------------------------
# STATE_FILE_PATH=C:/hsm-sync/.hsm-sync-state

# -----------------------------------------------------------------------------
# Extra excludes for file sync (comma-separated, appended to built-in defaults)
# Defaults already exclude: .git .env .env.* logs/ __pycache__/ *.pyc
# Example: RSYNC_EXCLUDES=*.mp4,uploads/large/
# -----------------------------------------------------------------------------
# RSYNC_EXCLUDES=
