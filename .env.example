# Server A — source
HTTDOCS_PATH=/var/www/httdocs

# Server B — replica
REMOTE_HOST=192.168.1.100
REMOTE_USER=deploy
REMOTE_PATH=/var/www/httdocs

# SSH key for A→B authentication (no password; key must be in B's authorized_keys)
SSH_KEY_PATH=/home/deploy/.ssh/hsm_sync_rsa

# Logging
LOCAL_LOG_PATH=logs/sync.log        # A-side JSON-lines log
REMOTE_LOG_PATH=/home/deploy/hsm-sync.log  # B-side append log
LOG_RETENTION_DAYS=7

# State file (tracks last synced commit hash; absence = first run)
# Default: .hsm-sync-state adjacent to LOCAL_LOG_PATH's parent directory
# STATE_FILE_PATH=/home/deploy/hsm-sync/.hsm-sync-state

# Extra rsync excludes (comma-separated, added to defaults)
# Defaults already exclude: .git/ .env .env.* logs/ __pycache__/ *.pyc
# RSYNC_EXCLUDES=*.mp4,uploads/
