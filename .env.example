# =============================================================================
# HSM Sync — environment configuration (Server A, Windows)
# Copy to .env and fill in all values before first run.
# =============================================================================
#
# PATH FORMAT NOTE — cwRsync uses Cygwin-style paths for anything rsync/SSH touches:
#   Windows path:  C:\www\httdocs
#   Cygwin path:   /cygdrive/c/www/httdocs
#
# Use Cygwin paths for HTTDOCS_PATH and SSH_KEY_PATH.
# Use normal Windows paths for LOCAL_LOG_PATH and STATE_FILE_PATH.
# Use normal Windows paths for REMOTE_LOG_PATH (it's passed to cmd.exe on Server B).

# -----------------------------------------------------------------------------
# Server A — source (this machine)
# -----------------------------------------------------------------------------

# Path to the httdocs git repo on Server A (Cygwin-style for cwRsync)
HTTDOCS_PATH=/cygdrive/c/inetpub/wwwroot

# -----------------------------------------------------------------------------
# Server B — replica target (Windows 10/11 with OpenSSH Server enabled)
# -----------------------------------------------------------------------------

REMOTE_HOST=192.168.1.100
REMOTE_USER=deploy

# Path to httdocs on Server B (Cygwin-style — cwRsync writes here over SSH)
REMOTE_PATH=/cygdrive/c/inetpub/wwwroot

# -----------------------------------------------------------------------------
# SSH authentication (A → B)
# Key must be added to Server B's %USERPROFILE%\.ssh\authorized_keys
# No passphrase; BatchMode=yes is set so SSH never prompts interactively.
# Use Cygwin-style path so cwRsync's bundled SSH can find the file.
# -----------------------------------------------------------------------------
SSH_KEY_PATH=/cygdrive/c/Users/deploy/.ssh/hsm_sync_rsa

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------

# A-side JSON-lines log — Windows path, created automatically
LOCAL_LOG_PATH=C:\Users\deploy\hsm-sync\logs\sync.log

# B-side append log — Windows path on Server B, written via SSH + cmd.exe
# Must be an absolute Windows path (e.g. C:\Users\deploy\hsm-sync.log)
REMOTE_LOG_PATH=C:\Users\deploy\hsm-sync.log

# How many days to keep A-side log entries (default: 7)
LOG_RETENTION_DAYS=7

# -----------------------------------------------------------------------------
# State file — tracks last synced commit hash; absence triggers a full rsync
# Default: .hsm-sync-state in the same folder as LOCAL_LOG_PATH
# Uncomment and set a Windows path to override.
# -----------------------------------------------------------------------------
# STATE_FILE_PATH=C:\Users\deploy\hsm-sync\.hsm-sync-state

# -----------------------------------------------------------------------------
# Extra rsync excludes (comma-separated, appended to built-in defaults)
# Defaults already exclude: .git/ .env .env.* logs/ __pycache__/ *.pyc
# Example: RSYNC_EXCLUDES=*.mp4,uploads/large/
# -----------------------------------------------------------------------------
# RSYNC_EXCLUDES=
